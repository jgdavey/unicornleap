program_name=unicornleap
image_folder=$(HOME)/.$(program_name)
build_folder=build
PREFIX ?= /usr/local
DESTDIR ?=

# The shipped binary is built with SwiftPM (see Package.swift, which also
# embeds the default images in the binary's __TEXT segment).
swift_build = swift build -c release
x86_64_triple = x86_64-apple-macosx10.15
arm64_triple = arm64-apple-macosx11

sources = $(wildcard UnicornLeap/*.swift)
binary = $(build_folder)/$(program_name)

# Shell completion scripts, generated by the built binary (swift-argument-parser
# writes them from the option definitions in Command.swift).
completions_folder = $(build_folder)/completions
zsh_completion = $(completions_folder)/_$(program_name)
bash_completion = $(completions_folder)/$(program_name).bash
fish_completion = $(completions_folder)/$(program_name).fish
completions = $(zsh_completion) $(bash_completion) $(fish_completion)

.PHONY: all universal completions test clean images install

all: $(binary) completions

# Rebuilt when a source file, the package or an embedded image changes, so
# `make install` never installs a stale binary.
$(binary): $(sources) Package.swift Package.resolved images/unicorn.png images/sparkle.png
	$(swift_build)
	mkdir -p $(build_folder)
	cp "$$($(swift_build) --show-bin-path)/$(program_name)" $@

# Universal (x86_64 + arm64) binary, as shipped in GitHub releases, plus the
# completions. arm64 macOS starts at 11.0, so that slice can't target 10.15.
universal:
	$(swift_build) --triple $(x86_64_triple)
	$(swift_build) --triple $(arm64_triple)
	mkdir -p $(build_folder)
	lipo -create -output $(binary) \
		"$$($(swift_build) --triple $(x86_64_triple) --show-bin-path)/$(program_name)" \
		"$$($(swift_build) --triple $(arm64_triple) --show-bin-path)/$(program_name)"
	$(MAKE) completions

completions: $(completions)

$(zsh_completion): $(binary)
	mkdir -p $(completions_folder)
	$(binary) --generate-completion-script zsh > $@.tmp && mv $@.tmp $@

$(bash_completion): $(binary)
	mkdir -p $(completions_folder)
	$(binary) --generate-completion-script bash > $@.tmp && mv $@.tmp $@

$(fish_completion): $(binary)
	mkdir -p $(completions_folder)
	$(binary) --generate-completion-script fish > $@.tmp && mv $@.tmp $@

test:
	swift test

images:
	mkdir -p $(image_folder)
	cp images/*.png $(image_folder)

# Completions go where each shell looks by default under a Homebrew-style
# prefix (zsh: site-functions; bash: bash-completion; fish: vendor_completions.d).
install: $(binary) completions
	install -d $(DESTDIR)$(PREFIX)/bin
	install -m 755 $(binary) $(DESTDIR)$(PREFIX)/bin/$(program_name)
	install -d $(DESTDIR)$(PREFIX)/share/zsh/site-functions
	install -m 644 $(zsh_completion) $(DESTDIR)$(PREFIX)/share/zsh/site-functions/_$(program_name)
	install -d $(DESTDIR)$(PREFIX)/share/bash-completion/completions
	install -m 644 $(bash_completion) $(DESTDIR)$(PREFIX)/share/bash-completion/completions/$(program_name)
	install -d $(DESTDIR)$(PREFIX)/share/fish/vendor_completions.d
	install -m 644 $(fish_completion) $(DESTDIR)$(PREFIX)/share/fish/vendor_completions.d/$(program_name).fish

clean:
	rm -rf $(build_folder) .build
